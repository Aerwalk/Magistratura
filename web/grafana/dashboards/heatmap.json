{
  "uid": "magsim-heatmap",
  "title": "MagSim — Перемещения РТС (тепловая карта / узкие места)",
  "tags": ["magsim"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "type": "heatmap",
      "title": "Тепловая карта посещений ячеек (узкие места)",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "continuous", "scheme": "interpolateOranges" } },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "color": { "mode": "scheme", "scheme": "interpolateOranges" },
        "yAxis": { "axisPlacement": "left", "unit": "short", "format": "short", "decimals": 0, "min": null, "max": null },
        "xBucketSize": null,
        "yBucketSize": null,
        "reverseYBuckets": false,
        "showValue": "auto",
        "tooltip": { "show": true, "yHistogram": false, "showHistogram": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "magsim_robot_cell_visits_total",
          "legendFormat": "robot_id={{robot_id}} cell={{cell}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Топ-10 ячеек по посещаемости (узкие места)",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "filterable": true },
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "showHeader": true },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "topk(10, sum by (cell) (magsim_robot_cell_visits_total))",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Посещения ячеек во времени (rate)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 20, "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (cell) (rate(magsim_robot_cell_visits_total[$__rate_interval]))",
          "legendFormat": "cell={{cell}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Выполненные задачи по РТС",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 20, "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (robot_id) (increase(magsim_robot_tasks_completed_total[$__rate_interval]))",
          "legendFormat": "РТС-{{robot_id}}",
          "refId": "A"
        }
      ]
    }
  ]
}
